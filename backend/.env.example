APP_NAME="Retail Soln"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Herd / sqlite default:
DB_CONNECTION=sqlite
# Docker Compose (MySQL) — uncomment when using docker compose:
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=retail_soln
# DB_USERNAME=retail
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Local default uses database queue/cache; Docker Compose uses Redis:
QUEUE_CONNECTION=database
CACHE_STORE=database
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Docker: REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,localhost:5174,localhost:5175,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:5175

# SPA origins for CORS (Bearer token auth; credentials false)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

VITE_APP_NAME="${APP_NAME}"

# Customer portal (Story 6.1) — leave empty to use first organization
CUSTOMER_PORTAL_ORGANIZATION_ID=
# Catalogue default store for price/stock (Story 6.2) — empty = first active store
CUSTOMER_PORTAL_DEFAULT_STORE_ID=
# Flat home-delivery fee (DECIMAL string; Story 6.3)
CUSTOMER_PORTAL_DELIVERY_FEE=0.0000
CUSTOMER_PORTAL_RESERVATION_TTL=60

# Payments (AD-10) — default manual for local/test; Stripe/Paystack stubs without keys
PAYMENT_PROVIDER=manual
PAYMENT_MANUAL_ENABLED=true
# Required for POST /api/v1/webhooks/payments/manual (not for shopper confirm-payment)
PAYMENT_MANUAL_WEBHOOK_SECRET=
PORTAL_FRONTEND_URL=http://localhost:5175
PAYMENT_ALLOWED_REDIRECT_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Max age (seconds) of a signed Stripe webhook timestamp before it is treated as a replay
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_CURRENCY=ngn
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=NGN

# Security (Story 9.1) — throttling and transport headers
API_RATE_LIMIT=120
PAYMENT_WEBHOOK_RATE_LIMIT=60
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_FRAME_OPTIONS=DENY

# Performance targets (Story 9.2) — informational for ops; not enforced in CI
SEARCH_P95_MS=200
SALE_COMPLETION_MS=3000
SEARCH_FUZZY_MIN_LENGTH=2
SEARCH_DEFAULT_LIMIT=25
SEARCH_MAX_LIMIT=50
